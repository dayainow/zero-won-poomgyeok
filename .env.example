PUBLIC_DATA_SERVICE_KEY=replace-with-data-go-kr-service-key
SEOUL_OPEN_API_KEY=replace-with-seoul-open-api-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Kakao Login (Supabase Auth > Providers > Kakao)
# - Kakao Developers: REST API 키 = Supabase Client ID, Client Secret = Supabase Client Secret
# - Kakao Redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# - Supabase Redirect URLs: zero-won-poomgyeok://auth/callback (+ Expo Go 개발용 redirect URI)
CRON_SECRET=replace-with-random-long-secret
PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
EXPO_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
EXPO_PUBLIC_LIBRARY_API_URL=https://your-vercel-domain.vercel.app/api/libraries
EXPO_PUBLIC_EVENTS_API_URL=https://your-vercel-domain.vercel.app/api/events
EXPO_PUBLIC_KAKAO_MAP_APP_KEY=replace-with-kakao-javascript-key
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=replace-with-naver-map-ncp-key-id
